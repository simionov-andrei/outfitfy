# ---------------------------------------------------------------------------
# Outfitfy environment variables
# Outfitfy is local-first: the app runs fully in the browser (IndexedDB) with
# zero keys configured. Every AI/API integration below degrades gracefully to
# a realistic mock so the ingestion, matching, VTO, and Pinterest pipelines
# all work out of the box. Add real keys to unlock live results.
# ---------------------------------------------------------------------------

# --- Vision tagging (Step A: Detection & Tagging) ---
# Used to detect clothing items in an uploaded/pinned photo and tag
# Category/Colors/Fabric/Pattern/Season.
# Preferred: Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Fallback if GEMINI_API_KEY isn't set: OpenAI gpt-4o-mini vision (paid).
OPENAI_API_KEY=

# --- Segmentation (Step B: background removal via Segment Anything) ---
# Hosted SAM model on Replicate. Both must be set to enable real segmentation.
REPLICATE_API_TOKEN=
REPLICATE_SAM_MODEL_VERSION=

# --- Virtual Try-On (IDM-VTON on Replicate) ---
# Reuses REPLICATE_API_TOKEN above; also requires the model version below.
REPLICATE_VTON_MODEL_VERSION=

# --- Tiered retail / visual search aggregator (Lykdat, Google Lens, etc.) ---
RETAIL_SEARCH_API_KEY=
RETAIL_SEARCH_ENDPOINT=

# --- Pinterest Developer API (board import) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Optional cloud sync auth (NextAuth) ---
# Cloud sync stays fully optional; the app defaults to local-only IndexedDB
# storage. Set AUTH_SECRET plus one provider's credentials to enable sign-in.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
